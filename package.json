{
  "name": "kiijs-sdk",
  "version": "0.5.1",
  "author": "kiiglobal.io <dev@kiiglobal.io>",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/KiiChain/kiijs-sdk"
  },
  "license": "SEE LICENSE IN LICENSE",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "tsc -p . && eslint scripts \"*.ts\" && turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"packages/*/{src,test,tests}/**/*.ts\" \"*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"packages/*/{src,test,tests}/**/*.ts\" \"*.ts\" \"scripts/**/*.ts\"",
    "codegen": "turbo run codegen",
    "clean": "rimraf -g \"packages/*/dist\" \"**/.turbo\" .pack"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^9.31.0",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-simple-import-sort": "^12.1.0",
    "eslint-plugin-unused-imports": "^4.0.0",
    "globals": "^16.0.0",
    "prettier": "3.6.2",
    "rimraf": "^6.1.3",
    "turbo": "^2.11.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript7": "npm:typescript@~7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "bun@1.4.4"
}
