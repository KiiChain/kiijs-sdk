{
  "name": "@kiichain/kiijs-evm",
  "version": "1.0.0",
  "description": "TypeScript library for EVM interactions on the Kii blockchain",
  "author": "kiiglobal.io <dev@kiiglobal.io>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/KiiChain/kiijs-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KiiChain/kiijs-sdk.git",
    "directory": "packages/evm"
  },
  "bugs": {
    "url": "https://github.com/KiiChain/kiijs-sdk/issues"
  },
  "keywords": [
    "kii",
    "javascript",
    "typescript",
    "node",
    "evm"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ethers": {
      "types": "./dist/ethers/index.d.ts",
      "default": "./dist/ethers/index.js"
    },
    "./viem": {
      "types": "./dist/viem/index.d.ts",
      "default": "./dist/viem/index.js"
    },
    "./wagmi": {
      "types": "./dist/wagmi/index.d.ts",
      "default": "./dist/wagmi/index.js"
    },
    "./precompiles": {
      "types": "./dist/precompiles/index.d.ts",
      "default": "./dist/precompiles/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ../../scripts/build.ts",
    "test": "vitest run",
    "lint": "tsc && eslint .",
    "lint:fix": "eslint . --fix",
    "codegen": "wagmi generate"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0",
    "ethers": "^6.0.0",
    "react": ">=18",
    "viem": "2.x",
    "wagmi": "^2.18.2"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "@wagmi/cli": "^2.7.0",
    "ethers": "^6.0.0",
    "react": "^19.0.0",
    "viem": "2.x",
    "wagmi": "^2.18.2"
  }
}
