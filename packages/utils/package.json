  },
  "scripts": {
    "build": "bun ../../scripts/build.ts",
    "test": "vitest run",
    "lint": "tsc && eslint .",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "ethers": "^6.0.0"
  },
  "devDependencies": {
    "ethers": "^6.0.0"
  },
  "dependencies": {
    "@cosmjs/encoding": "^0.33.1",
    "@cosmjs/proto-signing": "^0.33.1",
    "@cosmjs/stargate": "^0.33.1",
    "@kiichain/kiijs-proto": "workspace:^",
    "cosmjs-types": "^0.9.0"
  }
}
