{
  "name": "@kiichain/kiijs-utils",
  "version": "1.0.0",
  "description": "TypeScript utility library for the Kii blockchain",
  "author": "kiiglobal.io <dev@kiiglobal.io>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/KiiChain/kiijs-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KiiChain/kiijs-sdk.git",
    "directory": "packages/utils"
  },
  "bugs": {
    "url": "https://github.com/KiiChain/kiijs-sdk/issues"
  },
  "keywords": [
    "kii",
    "javascript",
    "typescript",
    "node",
    "utils"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
