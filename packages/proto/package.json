{
  "name": "@kiichain/kiijs-proto",
  "version": "1.0.0",
  "description": "JS SDK for kiichain protofiles",
  "author": "kiiglobal.io <dev@kiiglobal.io>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/KiiChain/kiijs-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KiiChain/kiijs-sdk.git",
    "directory": "packages/proto"
  },
  "bugs": {
    "url": "https://github.com/KiiChain/kiijs-sdk/issues"
  },
  "keywords": [
    "kii",
    "kiichain",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ../../scripts/build.ts",
    "test": "vitest run",
    "lint": "tsc",
    "codegen": "bun scripts/codegen.ts"
  },
  "dependencies": {
    "@cosmjs/amino": "^0.33.1",
    "@cosmjs/encoding": "^0.33.1",
    "@cosmjs/math": "^0.33.1",
    "@cosmjs/proto-signing": "^0.33.1",
    "@cosmjs/stargate": "^0.33.1",
    "@cosmjs/tendermint-rpc": "^0.33.1"
  },
  "devDependencies": {
    "@cosmology/telescope": "^1.10.0"
  }
}
